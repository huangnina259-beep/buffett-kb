# -----------------------------------------------------------------------------
# Generation models
# -----------------------------------------------------------------------------
# Simple default profile. Supported provider types: anthropic, openai,
# openai_compatible, gemini. Gemini uses its OpenAI-compatible endpoint and
# therefore requires AI_BASE_URL to be configured.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
AI_API_KEY_ENV=ANTHROPIC_API_KEY
# AI_BASE_URL=
ANTHROPIC_API_KEY=

# For multiple providers and per-task routing, provide JSON objects. API keys
# are referenced by environment-variable name and are never stored in JSON.
# AI_PROFILES_JSON={"claude":{"provider":"anthropic","model":"your-model-id","api_key_env":"ANTHROPIC_API_KEY"},"third_party":{"provider":"openai_compatible","model":"your-model-id","api_key_env":"THIRD_PARTY_API_KEY","base_url":"https://provider.example/v1"}}
# AI_TASKS_JSON={"knowledge_answer":{"primary":"claude","fallbacks":["third_party"],"max_tokens":4000,"temperature":0.2},"tutor_dialogue":"claude","coach_dialogue":"claude","structured_feedback":"claude","long_synthesis":"claude","daily_digest":"third_party"}
# THIRD_PARTY_API_KEY=

# A single task can also override its profile/model without changing JSON.
# AI_TASK_KNOWLEDGE_ANSWER_PROFILE=third_party
# AI_TASK_KNOWLEDGE_ANSWER_MODEL=your-other-model-id
# AI_TASK_KNOWLEDGE_ANSWER_FALLBACKS=claude

# Legacy daily-digest variables remain supported.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# DIGEST_MODEL=MiniMax-Text-01

# -----------------------------------------------------------------------------
# Embeddings (cloud API is the production default)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSION=1536
# Official OpenAI text-embedding-3 models can opt into output shortening.
# Keep this false/unused for compatible providers without Matryoshka support.
# EMBEDDING_REQUEST_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=64
OPENAI_API_KEY=

# Multiple embedding suppliers can be registered at once. Select exactly one
# active profile for the current VECTOR_COLLECTION.
# EMBEDDING_PROFILES_JSON={"openai_cloud":{"provider":"openai","model":"text-embedding-3-small","api_key_env":"OPENAI_API_KEY","dimension":1536},"third_party":{"provider":"openai_compatible","model":"your-embedding-model-id","api_key_env":"EMBEDDING_API_KEY","base_url":"https://provider.example/v1"}}
# EMBEDDING_ACTIVE_PROFILE=openai_cloud

# Any service implementing an OpenAI-compatible /embeddings endpoint:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=your-embedding-model-id
# EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
# EMBEDDING_BASE_URL=https://provider.example/v1
# EMBEDDING_API_KEY=

# Optional offline mode. Install requirements-local.txt first. This is not the
# production default because it consumes local CPU, RAM and disk.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384
# LOCAL_EMBEDDING_ALLOW_DOWNLOAD=false

# Each embedding model/version must use its own collection. Change this value
# when rebuilding with a different embedding profile, then switch deployments.
VECTOR_COLLECTION=buffett_kb_v2

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./coach.db
PORT=8000
