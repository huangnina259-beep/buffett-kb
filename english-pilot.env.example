# Copy to .env locally. Never commit real keys.
ENGLISH_PILOT_ENABLED=true
# Experimental second pass against the same originals; not a correctness guarantee.
ENGLISH_PILOT_VERIFY=true
ENGLISH_PILOT_CALL_LIMIT=40
AI_API_KEY=replace-on-the-server
AI_PROVIDER=openai_compatible
AI_MODEL=GLM-5.3-Flash-W8A8
AI_BASE_URL=https://openapi.wtsht.cn/v1
AI_PROFILES_JSON={"default":{"provider":"openai_compatible","model":"GLM-5.3-Flash-W8A8","api_key_env":"AI_API_KEY","base_url":"https://openapi.wtsht.cn/v1","timeout":110,"max_retries":0,"extra_body":{"thinking":{"type":"enabled"},"reasoning_effort":"high"}}}
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_KEY_ENV=AI_API_KEY
EMBEDDING_BASE_URL=https://openapi.wtsht.cn/v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=0
EMBEDDING_TIMEOUT=45
AUTO_INGEST=false
ANONYMIZED_TELEMETRY=False
AI_TASKS_JSON={"knowledge_answer":{"primary":"default","fallbacks":[],"max_tokens":12000,"temperature":0.2}}
